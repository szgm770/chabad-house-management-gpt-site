APP_URL=https://your-project.vercel.app
AUTH_SECRET=generate-a-long-random-secret
SESSION_SECRET=optional-stable-session-secret
ALLOWED_EMAILS=your-google-account@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# אפשרות נוחה במקום ה-ID: שם המסד שיצרת ב-Cloudflare (לדוגמה chabad-bs-production)
CLOUDFLARE_D1_DATABASE_NAME=
CLOUDFLARE_D1_API_TOKEN=
# מחרוזת אקראית ארוכה, שמופיעה רק ב-Vercel ובכתובת ה-Webhook של SUMIT.
SUMIT_WEBHOOK_TOKEN=generate-a-long-random-token
